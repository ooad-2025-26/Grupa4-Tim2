@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Zaboravljena lozinka";
}

<section class="auth-page-luxury">
    <div class="auth-card-luxury">
        <span class="auth-label">OCULIS RAČUN</span>

        <h1>Zaboravljena lozinka</h1>

        <p class="auth-description">
            Unesite email adresu povezanu s vašim računom i poslat ćemo vam upute za resetovanje lozinke.
        </p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="auth-form-group">
                <label asp-for="Input.Email">Email adresa</label>
                <input asp-for="Input.Email"
                       class="form-control auth-input"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="Unesite email adresu" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn auth-main-btn">
                Resetuj lozinku
            </button>
        </form>

        <div class="auth-back-link">
            <a asp-page="./Login">Nazad na prijavu</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
