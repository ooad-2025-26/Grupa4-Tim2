@page
@model IndexModel
@{
    ViewData["Title"] = "Moj profil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<section class="account-page">
    <div class="account-header">
        <span>OCULIS PROFIL</span>
        <h1>Moj profil</h1>
        <p>Uredite osnovne podatke svog korisničkog računa.</p>
    </div>

    <div class="account-layout">
        <aside class="account-sidebar">
            <partial name="_ManageNav" />
        </aside>

        <div class="account-card">
            <h2>Podaci o računu</h2>
            <p class="account-card-text">
                Ovdje možete pregledati korisničko ime i promijeniti broj telefona.
            </p>

            <partial name="_StatusMessage" for="StatusMessage" />

            <form id="profile-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="account-form-group">
                    <label asp-for="Username">Korisničko ime</label>
                    <input asp-for="Username" class="form-control account-input" disabled />
                </div>

                <div class="account-form-group">
                    <label asp-for="Input.PhoneNumber">Broj telefona</label>
                    <input asp-for="Input.PhoneNumber" class="form-control account-input" placeholder="Unesite broj telefona" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>

                <button id="update-profile-button" type="submit" class="btn account-save-btn">
                    Sačuvaj promjene
                </button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}