@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Promjena lozinke";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h2>Promjena lozinke</h2>


<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post">
    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"
         role="alert"></div>

    <div class="account-form-group">
        <label asp-for="Input.OldPassword"></label>
        <input asp-for="Input.OldPassword"
               class="form-control account-input"
               autocomplete="current-password"
               placeholder="Unesite trenutnu lozinku" />
        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
    </div>

    <div class="account-form-group">
        <label asp-for="Input.NewPassword"></label>
        <input asp-for="Input.NewPassword"
               class="form-control account-input"
               autocomplete="new-password"
               placeholder="Unesite novu lozinku" />
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>

    <div class="account-form-group">
        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword"
               class="form-control account-input"
               autocomplete="new-password"
               placeholder="Potvrdite novu lozinku" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn account-save-btn">
        Ažuriraj lozinku
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}