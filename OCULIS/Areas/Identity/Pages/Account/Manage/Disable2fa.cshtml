@page
@model Disable2faModel
@{
    ViewData["Title"] = "Onemogućavanje dvofaktorske autentifikacije (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Ova radnja samo onemogućava 2FA.</strong>
    </p>
    <p>
        Onemogućavanje 2FA ne mijenja ključeve korištene u aplikacijama za autentifikaciju. Ako želite promijeniti ključ
        u aplikaciji za autentifikaciju, trebate <a asp-page="./ResetAuthenticator">resetovati ključeve autentifikatora.</a>
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Onemogući 2FA</button>
    </form>
</div>
