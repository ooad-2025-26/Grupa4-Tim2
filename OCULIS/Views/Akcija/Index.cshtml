@model IEnumerable<OCULIS.Models.Akcija>
@{ ViewData["Title"] = "Akcije i popusti"; }

<h1 class="page-title"><i class="fa-solid fa-percent me-2"></i>Akcije i popusti</h1>
<a asp-action="Create" class="btn btn-oculis mb-3">Nova akcija</a>
<div class="table-oculis">
    <table class="table table-hover mb-0">
        <thead class="table-light"><tr><th>Naziv</th><th>Popust</th><th>Period</th><th>Proizvod</th><th>Aktivna</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Naziv</td>
                <td>@a.PopustPostotak%</td>
                <td>@a.DatumPocetka.ToString("dd.MM.") – @a.DatumZavrsetka.ToString("dd.MM.yyyy")</td>
                <td>@(a.Proizvod?.Naziv ?? "Svi proizvodi")</td>
                <td>@(a.Aktivna ? "Da" : "Ne")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Uredi</a>
                    <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-outline-danger">Obriši</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
