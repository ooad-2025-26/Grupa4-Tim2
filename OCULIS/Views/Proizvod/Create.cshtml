@model OCULIS.Models.Proizvod
@{ ViewData["Title"] = "Novi proizvod"; }

<h1 class="page-title">Novi proizvod</h1>
<div class="filter-card col-lg-8">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3"><label asp-for="Naziv" class="form-label"></label><input asp-for="Naziv" class="form-control" /><span asp-validation-for="Naziv"></span></div>
        <div class="mb-3"><label asp-for="Opis" class="form-label"></label><textarea asp-for="Opis" class="form-control" rows="3"></textarea></div>
        <div class="row">
            <div class="col-md-4 mb-3"><label asp-for="Cijena" class="form-label"></label><input asp-for="Cijena" class="form-control" /></div>
            <div class="col-md-4 mb-3"><label asp-for="Proizvodjac" class="form-label"></label><input asp-for="Proizvodjac" class="form-control" /></div>
            <div class="col-md-4 mb-3"><label asp-for="DostupnaKolicina" class="form-label"></label><input asp-for="DostupnaKolicina" class="form-control" /></div>
        </div>
        <div class="mb-3"><label asp-for="Kategorija" class="form-label"></label><select asp-for="Kategorija" class="form-select" asp-items="Html.GetEnumSelectList<OCULIS.Models.KategorijaProizvoda>()"></select></div>
        <button type="submit" class="btn btn-oculis">Spremi</button>
        <a asp-action="Index" class="btn btn-secondary">Nazad</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
