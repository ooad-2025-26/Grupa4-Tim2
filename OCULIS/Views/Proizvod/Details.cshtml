@model OCULIS.Models.Proizvod
@{
    ViewData["Title"] = Model.Naziv;
}

<div class="row">
    <div class="col-md-5">
        <div class="product-card">
            <div class="card-img-top" style="height:280px"><i class="fa-solid fa-glasses" style="font-size:5rem"></i></div>
        </div>
    </div>
    <div class="col-md-7">
        <h1 class="page-title">@Model.Naziv</h1>
        <p><span class="badge bg-primary">@Model.Kategorija</span></p>
        <p class="lead">@Model.Opis</p>
        <dl class="row">
            <dt class="col-sm-4">Proizvođač</dt><dd class="col-sm-8">@Model.Proizvodjac</dd>
            <dt class="col-sm-4">Cijena</dt><dd class="col-sm-8 fw-bold text-primary fs-4">@Model.Cijena.ToString("F2") KM</dd>
            <dt class="col-sm-4">Dostupnost</dt><dd class="col-sm-8">@Model.DostupnaKolicina kom</dd>
        </dl>
        @if (User.IsInRole("Kupac") || User.IsInRole("Administrator"))
        {
            <form asp-controller="Korpa" asp-action="Dodaj" method="post" class="d-flex gap-2 align-items-center">
                @Html.AntiForgeryToken()
                <input type="hidden" name="proizvodId" value="@Model.Id" />
                <input type="number" name="kolicina" value="1" min="1" max="@Model.DostupnaKolicina" class="form-control" style="width:80px" />
                <button type="submit" class="btn btn-oculis"><i class="fa-solid fa-cart-plus me-1"></i>Dodaj u korpu</button>
            </form>
        }
        @if (User.IsInRole("Administrator"))
        {
            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Uredi</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Obriši</a>
            </div>
        }
    </div>
</div>
