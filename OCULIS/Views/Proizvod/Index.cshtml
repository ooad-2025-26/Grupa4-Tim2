@model OCULIS.Models.ViewModels.ProizvodPretragaViewModel
@{
    ViewData["Title"] = "Proizvodi";
}

<h1 class="page-title"><i class="fa-solid fa-box-open me-2"></i>Proizvodi</h1>

<div class="filter-card">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <label class="form-label">Pretraga</label>
            <input asp-for="Pretraga" class="form-control" placeholder="Naziv, proizvođač..." />
        </div>
        <div class="col-md-2">
            <label class="form-label">Kategorija</label>
            <select asp-for="Kategorija" class="form-select" asp-items="Html.GetEnumSelectList<OCULIS.Models.KategorijaProizvoda>()">
                <option value="">Sve</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Proizvođač</label>
            <input asp-for="Proizvodjac" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Min cijena</label>
            <input asp-for="MinCijena" type="number" step="0.01" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Max cijena</label>
            <input asp-for="MaxCijena" type="number" step="0.01" class="form-control" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Sort</label>
            <select asp-for="Sortiranje" class="form-select">
                <option value="naziv">Naziv</option>
                <option value="cijena_asc">Cijena ↑</option>
                <option value="cijena_desc">Cijena ↓</option>
            </select>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-oculis"><i class="fa-solid fa-search me-1"></i>Pretraži</button>
            @if (User.IsInRole("Administrator"))
            {
                <a asp-action="Create" class="btn btn-outline-primary ms-2">Novi proizvod</a>
            }
        </div>
    </form>
</div>

<div class="row g-4">
@foreach (var p in Model.Proizvodi)
{
    <div class="col-md-6 col-lg-4 col-xl-3">
        <div class="product-card">
            <div class="card-img-top"><i class="fa-solid fa-glasses"></i></div>
            <div class="card-body">
                <span class="badge bg-secondary mb-2">@p.Kategorija</span>
                <h5>@p.Naziv</h5>
                <p class="text-muted small mb-1">@p.Proizvodjac</p>
                <p class="fw-bold text-primary">@p.Cijena.ToString("F2") KM</p>
                <p class="small text-muted">Dostupno: @p.DostupnaKolicina</p>
                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-oculis">Detalji</a>
            </div>
        </div>
    </div>
}
</div>

@if (!Model.Proizvodi.Any())
{
    <div class="alert alert-info">Nema proizvoda za zadate kriterije pretrage.</div>
}
