@model OCULIS.Models.ViewModels.KorpaViewModel
@{ ViewData["Title"] = "Korpa"; }

<h1 class="page-title"><i class="fa-solid fa-cart-shopping me-2"></i>Korpa</h1>

@if (Model.Stavke.Any())
{
    <div class="table-oculis">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Proizvod</th><th>Cijena</th><th>Količina</th><th>Ukupno</th><th></th></tr></thead>
            <tbody>
            @foreach (var s in Model.Stavke)
            {
                <tr>
                    <td>@s.NazivProizvoda</td>
                    <td>@s.Cijena.ToString("F2") KM</td>
                    <td>@s.Kolicina</td>
                    <td class="fw-bold">@s.Ukupno.ToString("F2") KM</td>
                    <td>
                        <form asp-action="Ukloni" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="stavkaId" value="@s.Id" />
                            <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Popust != null)
    {
        <div class="filter-card mt-4 col-lg-6">
            <h5>Obračun popusta</h5>
            <p>Osnovna cijena: <strong>@Model.Popust.OsnovnaCijena.ToString("F2") KM</strong></p>
            @foreach (var p in Model.Popust.PrimijenjeniPopusti)
            {
                <span class="badge bg-success me-1">@p</span>
            }
            <p class="mt-2">Primijenjeni popust: <strong>@Model.Popust.PopustPostotak% (-@Model.Popust.PopustIznos.ToString("F2") KM)</strong></p>
            <p class="fs-4 text-primary">Ukupno: <strong>@Model.Popust.UkupnaCijena.ToString("F2") KM</strong></p>
        </div>
    }

    <a asp-action="Checkout" class="btn btn-oculis btn-lg mt-3"><i class="fa-solid fa-credit-card me-1"></i>Nastavi na narudžbu</a>
}
else
{
    <div class="alert alert-info">Korpa je prazna. <a asp-controller="Proizvod" asp-action="Index">Pregledaj proizvode</a></div>
}
