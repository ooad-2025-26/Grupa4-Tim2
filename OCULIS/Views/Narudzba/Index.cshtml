@model IEnumerable<OCULIS.Models.Narudzba>
@{ ViewData["Title"] = "Narudžbe"; }

<h1 class="page-title"><i class="fa-solid fa-receipt me-2"></i>Narudžbe</h1>

<div class="table-oculis">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr><th>#</th><th>Datum</th><th>Korisnik</th><th>Status</th><th>Ukupno</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var n in Model)
        {
            <tr>
                <td>@n.Id</td>
                <td>@n.DatumNarudzbe.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@n.Korisnik?.Ime @n.Korisnik?.Prezime</td>
                <td><span class="badge bg-info">@n.Status</span></td>
                <td class="fw-bold">@n.UkupnaCijena.ToString("F2") KM</td>
                <td><a asp-action="Details" asp-route-id="@n.Id" class="btn btn-sm btn-outline-primary">Detalji</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
