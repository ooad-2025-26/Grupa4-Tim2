@model OCULIS.Models.PregledVida
@{ ViewData["Title"] = "Novi pregled vida"; }

<h1 class="page-title">Evidentiraj pregled vida</h1>
<div class="filter-card col-lg-8">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="IdElektronskiKarton" class="form-label">Elektronski karton</label>
            <select asp-for="IdElektronskiKarton" class="form-select" asp-items="ViewBag.IdElektronskiKarton"></select>
        </div>
        <div class="mb-3"><label asp-for="DatumPregleda" class="form-label"></label><input asp-for="DatumPregleda" type="date" class="form-control" /></div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="DioptrijaLijevo" class="form-label"></label><input asp-for="DioptrijaLijevo" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label asp-for="DioptrijaDesno" class="form-label"></label><input asp-for="DioptrijaDesno" class="form-control" /></div>
        </div>
        <div class="mb-3"><label asp-for="Preporuka" class="form-label"></label><textarea asp-for="Preporuka" class="form-control" rows="3"></textarea></div>
        <button type="submit" class="btn btn-oculis">Spremi</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
