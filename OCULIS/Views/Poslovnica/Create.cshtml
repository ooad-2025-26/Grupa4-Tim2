@model OCULIS.Models.Poslovnica
@{ ViewData["Title"] = "Nova poslovnica"; }

<h1 class="page-title">Nova poslovnica</h1>
<div class="filter-card col-lg-8">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3"><label asp-for="Naziv" class="form-label"></label><input asp-for="Naziv" class="form-control" /></div>
        <div class="mb-3"><label asp-for="Adresa" class="form-label"></label><input asp-for="Adresa" class="form-control" /></div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="Telefon" class="form-label"></label><input asp-for="Telefon" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label asp-for="RadnoVrijeme" class="form-label"></label><input asp-for="RadnoVrijeme" class="form-control" /></div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="Latitude" class="form-label"></label><input asp-for="Latitude" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label asp-for="Longitude" class="form-label"></label><input asp-for="Longitude" class="form-control" /></div>
        </div>
        <button type="submit" class="btn btn-oculis">Spremi</button>
        <a asp-action="Index" class="btn btn-secondary">Nazad</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
