@model IEnumerable<OCULIS.Models.Poslovnica>

@{
    ViewData["Title"] = "Poslovnice";
    var apiKey = ViewBag.GoogleMapsApiKey as string;
}

<section class="branches-header">
    <span class="catalog-label">OCULIS MREŽA</span>
    <h1 class="branches-title">
        <i class="fa-solid fa-map-location-dot me-2"></i>Poslovnice
    </h1>
    <p class="branches-subtitle">
        Pronađite najbližu OCULIS poslovnicu i pregledajte osnovne informacije, lokaciju i radno vrijeme.
    </p>
</section>

<div class="branches-top-layout">
    <div class="branches-map-card branches-map-full">
        @if (string.IsNullOrWhiteSpace(apiKey))
        { 
            <div class="map-placeholder"> 
                <i class="fa-solid fa-map-location-dot"></i> 
                <h4>Mapa trenutno nije dostupna</h4> 
                </div> }
        else
        {
            <div id="map"></div>
        }
    </div>
</div>

<div class="branches-grid">
    @foreach (var p in Model)
    {
        <div class="branch-card"
             data-naziv="@p.Naziv"
             data-adresa="@p.Adresa"
             data-lat="@p.Latitude"
             data-lng="@p.Longitude">

            <h4>@p.Naziv</h4>

            <div class="branch-meta">
                <p><i class="fa-solid fa-location-dot"></i> @p.Adresa</p>
                <p><i class="fa-solid fa-phone"></i> @p.Telefon</p>
                <p><i class="fa-solid fa-clock"></i> @p.RadnoVrijeme</p>
            </div>

            <a asp-action="Details" asp-route-id="@p.Id" class="btn branch-show-btn">
                Prikaži
            </a>
        </div>
    }
</div>

@section Scripts {
    @if (!string.IsNullOrWhiteSpace(apiKey))
    {
        <script src="https://maps.googleapis.com/maps/api/js?key=@apiKey"></script>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
            const mapElement = document.getElementById("map");

            if (!mapElement || typeof google === "undefined") {
            return;
            }

            const defaultCenter = { lat: 43.8563, lng: 18.4131 };

            const map = new google.maps.Map(mapElement, {
            zoom: 11,
            center: defaultCenter,
            styles: []
            });

            const infoWindow = new google.maps.InfoWindow();

            document.querySelectorAll(".branch-card").forEach(card => {
            const naziv = card.dataset.naziv;
            const adresa = card.dataset.adresa;
            const lat = parseFloat(card.dataset.lat);
            const lng = parseFloat(card.dataset.lng);

            if (!isNaN(lat) && !isNaN(lng) && lat !== 0 && lng !== 0) {
            const marker = new google.maps.Marker({
            position: { lat, lng },
            map: map,
            title: naziv
            });

            marker.addListener("click", () => {
            map.panTo({ lat, lng });
            map.setZoom(13);

            infoWindow.setContent(`
            <div style="padding:6px 8px;">
            <strong>${naziv}</strong><br/>
            <span>${adresa}</span>
            </div>
            `);

            infoWindow.open(map, marker);
            });
            }
            });
            });
        </script>
    }
}