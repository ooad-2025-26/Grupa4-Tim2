@model IEnumerable<OCULIS.Models.Placanje>
@{ ViewData["Title"] = "Plaćanja"; }

<h1 class="page-title"><i class="fa-solid fa-money-bill me-2"></i>Plaćanja</h1>
<div class="table-oculis">
    <table class="table table-hover mb-0">
        <thead class="table-light"><tr><th>Datum</th><th>Narudžba</th><th>Korisnik</th><th>Način</th><th>Iznos</th><th>Status</th><th>Referenca</th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.DatumPlacanja.ToString("dd.MM.yyyy HH:mm")</td>
                <td>#@p.IdNarudzba</td>
                <td>@p.Narudzba?.Korisnik?.Ime @p.Narudzba?.Korisnik?.Prezime</td>
                <td>@p.NacinPlacanja</td>
                <td>@p.Iznos.ToString("F2") KM</td>
                <td><span class="badge bg-@(p.StatusPlacanja == OCULIS.Models.StatusPlacanja.Uspjesno ? "success" : p.StatusPlacanja == OCULIS.Models.StatusPlacanja.Odbijeno ? "danger" : "warning")">@p.StatusPlacanja</span></td>
                <td>@p.ReferencaTransakcije</td>
            </tr>
        }
        </tbody>
    </table>
</div>
