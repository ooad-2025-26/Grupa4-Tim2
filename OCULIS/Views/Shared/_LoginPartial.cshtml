@using Microsoft.AspNetCore.Identity
@inject SignInManager<Korisnik> SignInManager
@inject UserManager<Korisnik> UserManager

<ul class="navbar-nav auth-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);

        <li class="nav-item">
            <span class="nav-link auth-user">
                <i class="fa-solid fa-user me-1"></i>@user?.Ime @user?.Prezime
            </span>
        </li>

        <li class="nav-item">
            <a class="nav-link auth-link" asp-area="Identity" asp-page="/Account/Manage/Index">
                Profil
            </a>
        </li>

        <li class="nav-item">
            <form class="auth-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")">
                <button type="submit" class="nav-link auth-link auth-button">
                    Odjava
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link auth-link" asp-area="Identity" asp-page="/Account/Register">
                Registracija
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link auth-link auth-login" asp-area="Identity" asp-page="/Account/Login">
                Prijava
            </a>
        </li>
    }
</ul>