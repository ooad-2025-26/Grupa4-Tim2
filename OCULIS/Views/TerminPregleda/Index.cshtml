@model IEnumerable<OCULIS.Models.TerminPregleda>
@{ ViewData["Title"] = "Termini pregleda"; }

<h1 class="page-title"><i class="fa-solid fa-calendar me-2"></i>Termini pregleda</h1>

@if (User.IsInRole("Kupac"))
{
    <a asp-action="Zakazi" class="btn btn-oculis mb-3"><i class="fa-solid fa-plus me-1"></i>Zakaži novi termin</a>
}

<div class="table-oculis">
    <table class="table table-hover mb-0">
        <thead class="table-light"><tr><th>Datum</th><th>Vrijeme</th><th>Poslovnica</th><th>Korisnik</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Datum.ToString("dd.MM.yyyy")</td>
                <td>@t.Vrijeme.ToString(@"hh\:mm")</td>
                <td>@t.Poslovnica?.Naziv</td>
                <td>@t.Korisnik?.Ime @t.Korisnik?.Prezime</td>
                <td><span class="badge bg-info">@t.Status</span></td>
                <td><a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Detalji</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
