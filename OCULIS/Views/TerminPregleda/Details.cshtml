@model OCULIS.Models.TerminPregleda
@{ ViewData["Title"] = "Detalji termina"; }

<h1 class="page-title">Termin pregleda</h1>
<div class="filter-card col-lg-6">
    <dl class="row">
        <dt class="col-4">Datum</dt><dd class="col-8">@Model.Datum.ToString("dd.MM.yyyy")</dd>
        <dt class="col-4">Vrijeme</dt><dd class="col-8">@Model.Vrijeme.ToString(@"hh\:mm")</dd>
        <dt class="col-4">Poslovnica</dt><dd class="col-8">@Model.Poslovnica?.Naziv — @Model.Poslovnica?.Adresa</dd>
        <dt class="col-4">Korisnik</dt><dd class="col-8">@Model.Korisnik?.Ime @Model.Korisnik?.Prezime</dd>
        <dt class="col-4">Status</dt><dd class="col-8"><span class="badge bg-info">@Model.Status</span></dd>
    </dl>
    @if (User.IsInRole("Zaposlenik") || User.IsInRole("Administrator"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Promijeni status</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</div>
